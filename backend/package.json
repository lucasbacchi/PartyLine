{
    "name": "partyline-backend",
    "version": "0.0.1",
    "description": "An express application for the PartyLine phone system",
    "license": "ISC",
    "author": "",
    "type": "module",
    "main": "dist/index.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy.ps1",
        "check": "prettier --check .",
        "format": "prettier --write .",
        "lint": "eslint . --max-warnings=0",
        "update": "npm-check-updates --target semver --upgrade"
    },
    "dependencies": {
        "@google-cloud/firestore": "^9.4.0",
        "@google-cloud/storage": "^8.1.0",
        "cors": "^2.8.6",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.4",
        "firebase-admin": "^14.5.1",
        "twilio": "^6.3.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild": false,
        "@firebase/util@1.15.3": true,
        "protobufjs@7.6.6": true
    }
}
